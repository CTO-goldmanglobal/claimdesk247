# ClaimDesk 247 — environment variables (template).
#
# Copy to `.env` (local dev) or set in your Vercel project (production). NEVER
# commit real values. The two-machine sync rule means the same vars must exist
# on both the MacBook Air and the Mac Studio — keep them in sync.

# ---------------------------------------------------------------------------
# Engine core (existing)
# ---------------------------------------------------------------------------
APP_ENV=preview                       # preview | production (prod disables x-test-mode)
CORS_ALLOWED_ORIGINS=https://preview--smash-repair-engine.lovable.app,http://localhost:3000
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_BURST=5

# Supabase project (engine SessionStore + Postgres for evidence metadata)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server-side only; never ship to the browser
BRIEF_AUTH_MODE=stub                              # stub | jwt (jwt = real AAL2 path)

# Runtime tokens (resolved in engine output)
FIRM_NAME=ClaimDesk 247
FIRM_PHONE=
CALLBACK_SLA=within 1 business hour
BUSINESS_HOURS=Mon–Fri 8am–6pm AEST
RETENTION_PERIOD=7 years
TOW_PROVIDER_REF=
RENTAL_PARTNER_REF=
PERSONA_NAME=

# ---------------------------------------------------------------------------
# Feature 2 — Evidence upload (AWS S3, Sydney ap-southeast-2)
# ---------------------------------------------------------------------------
# The bucket MUST be private + block-all-public-access + SSE-KMS. See
# stage-4/EVIDENCE-STORAGE-SETUP.md for the full AWS console runbook.

# Bucket name (e.g. claimdesk247-evidence-prod). Required for the S3 path.
EVIDENCE_BUCKET_NAME=

# Region. ap-southeast-2 (Sydney) is the default and matches the privacy
# notice's "stored in Australia" promise. Do NOT override without a legal basis.
EVIDENCE_S3_REGION=ap-southeast-2

# Optional KMS Customer Managed Key (CMK) ARN. If unset, the AWS-managed key
# `aws/s3` is used (still SSE-KMS, just shared). A CMK gives you separate key
# rotation + CloudTrail on key use; recommended for production.
EVIDENCE_KMS_KEY_ID=

# AWS credentials. Use a dedicated IAM user scoped to ONE bucket (see the
# runbook for the least-privilege policy). Region must match the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# Per-file size cap (MB). The frontend resizes to ~1600px / JPEG q80 before
# upload (~300KB typical); this is the safety net for raw originals.
EVIDENCE_MAX_FILE_MB=10

# Per-case count cap. Stops a runaway client from exhausting the bucket.
EVIDENCE_MAX_FILES_PER_CASE=20

# Signed-URL TTL (seconds). Short by design — no PII in URLs, short exposure.
EVIDENCE_SIGNED_URL_TTL=900
