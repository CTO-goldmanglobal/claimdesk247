{
  "$comment": "ClaimDesk 247 — Public Liability sub-tree (v1). Personal-injury extension per spec 2026-07-03 Part 2. Governing law: NSW Civil Liability Act 2002 (NOT the Motor Accidents Injuries Act). Liability turns on duty of care, foreseeability, reasonable precautions (s5B/s5C) and contributory negligence (s5R). Every rule and threshold below is a DRAFT for Legal Head sign-off under CD-E4/CD-G2 — none of it is legal advice. Each scenario ships with an empty legal_signoff so the engine escalates (unsigned-scenario) until Legal Head signs this tree's hash. Band enum is strictly likely|possible|unclear|insufficient (the spec prose 'unlikely' maps to 'unclear'). No numeric fault percentage is assigned anywhere. Tokens {{...}} resolve at render time.",
  "version": "1.0.0",
  "jurisdiction": "NSW",
  "claim_type": "public_liability",
  "governing_law": "Civil Liability Act 2002 (NSW)",
  "spec_change": "v1.0.0 — Initial PL sub-tree. Scenarios pl1-pl6. Per-tree hashing: this tree's sign-off is bound to its own scenarios[] hash and is independent of the motor and med-neg trees.",
  "builder": "Cursor (Personal-Injury Extension, spec 2026-07-03)",
  "build_date": "2026-07-04",
  "global_escalation_triggers": [
    {
      "id": "esc-injury",
      "condition": "any injury reported (minor or serious)",
      "applicability": "all"
    },
    {
      "id": "esc-vulnerable",
      "condition": "child or elderly claimant",
      "applicability": "public_liability"
    },
    {
      "id": "esc-fraud",
      "condition": "story inconsistency, third-party pressure",
      "applicability": "all"
    },
    {
      "id": "esc-dispute",
      "condition": "customer disputes the AI's summary",
      "applicability": "all"
    },
    {
      "id": "esc-multiparty",
      "condition": "multiple defendants/occupiers",
      "applicability": "public_liability"
    },
    {
      "id": "esc-advice",
      "condition": "customer asks for legal advice directly",
      "applicability": "all"
    },
    {
      "id": "esc-serious-injury",
      "condition": "death, permanent impairment, hospitalisation",
      "applicability": "all"
    },
    {
      "id": "esc-workers-comp",
      "condition": "injury in the course of employment",
      "applicability": "public_liability"
    },
    {
      "id": "esc-govt-defendant",
      "condition": "defendant is a council / public authority / government",
      "applicability": "public_liability"
    },
    {
      "id": "esc-limitation",
      "condition": "incident date > ~2.5 yrs ago (buffer)",
      "applicability": "public_liability"
    }
  ],
