    {
      "id": "pl1-slip-wet-surface",
      "name": "Slip on a wet surface",
      "status": "DRAFT_FOR_LEGAL_SIGNOFF",
      "rule_citations": [
        {
          "rule": "CLA s5B",
          "title": "Standard of care — reasonable precautions"
        },
        {
          "rule": "CLA s5C",
          "title": "Other principles — burden of taking precautions"
        },
        {
          "rule": "CLA s5R",
          "title": "Contributory negligence"
        }
      ],
      "classification_questions": [
        {
          "id": "pl1-q1",
          "slot": "pl_location",
          "question_web": "Where did the slip happen?",
          "answer_type": "enum",
          "options": [
            "supermarket",
            "shopping_centre",
            "footpath_council",
            "private_premises",
            "workplace",
            "other"
          ],
          "validation": "must be one option",
          "reprompt_max": 2
        },
        {
          "id": "pl1-q2",
          "slot": "hazard_type",
          "question_web": "What made the surface wet?",
          "answer_type": "enum",
          "options": [
            "spill",
            "cleaning",
            "rain_tracked",
            "condensation",
            "other"
          ],
          "validation": "must be one option",
          "reprompt_max": 2
        },
        {
          "id": "pl1-q3",
          "slot": "hazard_warned",
          "question_web": "Was there a wet-floor sign or warning?",
          "answer_type": "enum",
          "options": [
            "yes",
            "no",
            "unsure"
          ],
          "validation": "must be one option",
          "reprompt_max": 2
        },
        {
          "id": "pl1-q4",
          "slot": "hazard_duration",
          "question_web": "How long do you think the hazard had been there?",
          "answer_type": "enum",
          "options": [
            "just_happened",
            "short",
            "long",
            "extended",
            "30min_plus",
            "unsure"
          ],
          "validation": "must be one option",
          "reprompt_max": 2
        },
        {
          "id": "pl1-q5",
          "slot": "claimant_activity",
          "question_web": "What were you doing at the time?",
          "answer_type": "enum",
          "options": [
            "walking_normally",
            "rushing",
            "carrying_items",
            "on_phone",
            "other"
          ],
          "validation": "must be one option",
          "reprompt_max": 2
        }
      ],
      "default_pattern": {
        "description": "Occupier liable when a foreseeable wet hazard was present long enough to address and no warning was given (CLA s5B/s5C)",
        "favours": "claimant"
      },
      "exceptions": [
        {
          "id": "pl1-e1",
          "probe_question": "Were you walking in an unusual or careless way?",
          "slot": "claimant_at_fault",
          "effect": "downgrade_band"
        },
        {
          "id": "pl1-e2",
          "probe_question": "Was the hazard brand new (just seconds old)?",
          "slot": "transient_hazard",
          "effect": "flag_unclear"
        }
      ],
      "damage_consistency_check": {
        "expected": "n/a — PL has no vehicle damage map",
        "on_mismatch": "n/a"
      },
      "band_logic": [
        {
          "when": "long-present hazard AND no warning AND claimant acting reasonably",
          "band": "likely"
        },
        {
          "when": "warning given OR short duration OR contributory factors",
          "band": "possible"
        },
        {
          "when": "transient hazard with prompt response",
          "band": "unclear"
        },
        {
          "when": "classification questions incomplete after reprompts",
          "band": "insufficient"
        }
      ],
      "outputs": [
        {
          "band": "likely",
          "text_web": "Slip-and-fall claims on wet surfaces in NSW are assessed under the Civil Liability Act 2002. Where a foreseeable hazard was present long enough for the occupier to address and no warning was given, occupiers are often found to have failed to take reasonable precautions. Your description fits that pattern. Whether it applies depends on the full evidence. {{ATTACH:master}}"
        },
        {
          "band": "possible",
          "text_web": "Your slip may give rise to a public-liability claim under the Civil Liability Act 2002, but one or more factors you've described (such as a warning sign, a short-lived hazard, or your own conduct) can affect how these matters are assessed. {{ATTACH:master}}"
        },
        {
          "band": "unclear",
          "text_web": "The circumstances of your slip don't fit the standard occupier-liability pattern neatly — for example the hazard may have been too brief to address. This is exactly the kind of situation a lawyer should review. {{ATTACH:master}}"
        },
        {
          "band": "insufficient",
          "text_web": "There isn't enough detail yet to match your matter to a common pattern. A lawyer will review what you've provided and follow up. {{ATTACH:master}}"
        }
      ],
      "escalation_overrides": [
        {
          "condition": "pl_location = workplace",
          "action": "route_to_esc-workers-comp"
        },
        {
          "condition": "pl_location = footpath_council",
          "action": "route_to_esc-govt-defendant"
        }
      ],
      "legal_signoff": {
        "approved": true,
        "version": "dc824c3559ab08bac43ad90ba0973b3cad0499071b4b4016a59a0abc17e728ec",
        "by": "Legal Head — Goldman Global, provisional approval pending final UX-level sign-off (2026-07-05)",
        "date": "2026-07-05"
      }
    },
